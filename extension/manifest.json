{
  "manifest_version": 3,
  "name": "MemoryBridge Companion",
  "version": "0.4.0",
  "description": "Pair with the MemoryBridge dashboard and save local manual drafts. Does not grant paid entitlement.",
  "action": {
    "default_title": "MemoryBridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "include_globs": ["*/app/dashboard.html*", "*/app/records.html*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
