# Backend API origin (no trailing slash). Injected at Vite build/dev time.
#
# Local API on :8000 while Vite runs on :5173:
# VITE_API_URL=http://localhost:8000
#
# Same-origin (SPA served by FastAPI): leave unset / empty.
#
# Production Railway:
VITE_API_URL=https://memorybridge-api-production.up.railway.app
