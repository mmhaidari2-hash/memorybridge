# MemoryBridge v0.4 commercial foundation
# Customer-facing deployments MUST set APP_ENV=production. In production the
# application fails closed on placeholders, non-HTTPS origins/redirects, invalid
# encryption configuration, and inconsistent Stripe Test/Live credentials.
APP_ENV=development

# Generate an encryption key with:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Generate a legacy service API key with:
# python -c "import secrets; print('mbs_' + secrets.token_urlsafe(32))"
DATABASE_URL=postgresql://memorybridge:change-me@localhost:5432/memorybridge
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SERVICE_API_KEYS=mbs_REPLACE_WITH_STRONG_RANDOM_KEY

# Browser origins allowed to call the API directly. Use exact HTTPS origins,
# comma-separated when more than one web origin is required. Wildcard (*) is
# deliberately rejected by the application.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Process-local limiter defaults. Use a distributed backend such as Redis
# before horizontally scaling across multiple application instances.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Stripe staging/test configuration.
# IMPORTANT: the application uses these exact generic variable names in both
# Test and Live Mode; there are no STRIPE_TEST_* aliases. BILLING_MODE selects
# the namespace and production validation requires sk_test_ when mode=test.
BILLING_MODE=test
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_TEST_PRICE_ID
STRIPE_PRICE_TEAM=price_REPLACE_WITH_TEAM_TEST_PRICE_ID

# Use HTTPS URLs for deployed environments. These redirects do not grant
# entitlements; paid access changes only after a verified Stripe webhook.
BILLING_SUCCESS_URL=https://YOUR-STAGING-HOST/app/dashboard.html?billing=success
BILLING_CANCEL_URL=https://YOUR-STAGING-HOST/app/dashboard.html?billing=cancel
