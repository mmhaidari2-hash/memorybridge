# MemoryBridge v0.3 development
# Generate an encryption key with:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Generate a service API key with:
# python -c "import secrets; print('mbs_' + secrets.token_urlsafe(32))"

DATABASE_URL=postgresql://memorybridge:change-me@localhost:5432/memorybridge
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SERVICE_API_KEYS=mbs_REPLACE_WITH_STRONG_RANDOM_KEY

# Process-local limiter defaults. Use a distributed backend such as Redis
# before horizontally scaling across multiple application instances.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
