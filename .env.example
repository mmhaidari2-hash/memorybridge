# MemoryBridge v0.4 commercial foundation
# Generate an encryption key with:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Generate a legacy service API key with:
# python -c "import secrets; print('mbs_' + secrets.token_urlsafe(32))"

DATABASE_URL=postgresql://memorybridge:change-me@localhost:5432/memorybridge
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
SERVICE_API_KEYS=mbs_REPLACE_WITH_STRONG_RANDOM_KEY

# Process-local limiter defaults. Use a distributed backend such as Redis
# before horizontally scaling across multiple application instances.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Stripe Test Mode. Never commit real keys or webhook secrets.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_TEST_PRICE_ID
STRIPE_PRICE_TEAM=price_REPLACE_WITH_TEAM_TEST_PRICE_ID

# Use HTTPS URLs for deployed environments. These redirects do not grant
# entitlements; paid access changes only after a verified Stripe webhook.
BILLING_SUCCESS_URL=https://example.com/billing/success
BILLING_CANCEL_URL=https://example.com/billing/cancel
