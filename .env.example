# MemoryBridge v0.4 development
# Generate an encryption key with:
# python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Generate a service API key with:
# python3 -c "import secrets; print('mbs_' + secrets.token_urlsafe(32))"
# Generate an admin API key with:
# python3 -c "import secrets; print('mba_' + secrets.token_urlsafe(32))"
# Generate a token hash pepper with:
# python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"

DATABASE_URL=postgresql://memorybridge:change-me@localhost:5432/memorybridge

# Single-key mode (version 1):
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Optional multi-key rotation mode (preferred in production):
# ENCRYPTION_KEYS=1:<base64-key-v1>,2:<base64-key-v2>
# ENCRYPTION_ACTIVE_VERSION=2

SERVICE_API_KEYS=mbs_REPLACE_WITH_STRONG_RANDOM_KEY
ADMIN_API_KEY=mba_REPLACE_WITH_STRONG_RANDOM_ADMIN_KEY
TOKEN_HASH_PEPPER=REPLACE_WITH_16+_BYTE_BASE64_PEPPER

# Process-local limiter defaults. Use a distributed backend such as Redis
# before horizontally scaling across multiple application instances.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Reject bodies larger than this when Content-Length is present.
MAX_REQUEST_BYTES=262144

METRICS_ENABLED=true
DEFAULT_TENANT_SLUG=default

# Billing / Stripe (optional until you want card checkout)
# Without Stripe you can still charge offline and assign plans via admin API.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
PUBLIC_BASE_URL=http://localhost:8000
# BILLING_SUCCESS_URL=https://yourapp.com/billing/success
# BILLING_CANCEL_URL=https://yourapp.com/billing/cancel
